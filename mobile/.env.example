# Reverse-proxy base URL. Required; the app has no default.
# The proxy (M5-1) listens on port 8000 by default (PROXY_PORT in the root .env).
# The proxy routes /api to the C# API and /notify to the Spring service.
# On a phone use your machine's LAN address, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://<LAN IP of the machine running Compose>:8000
