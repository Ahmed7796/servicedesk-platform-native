{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servicedesk.example/contracts/events/defs.schema.json",
  "title": "Shared definitions for ServiceDesk events",
  "description": "Enum values mirror the C# enums in servicedesk-api/src/ServiceDesk.Domain/Enums and are serialised as their names.",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "requestType": {
      "type": "string",
      "enum": [
        "Equipment",
        "SoftwareAccess",
        "Leave",
        "Purchase"
      ]
    },
    "requestStatus": {
      "type": "string",
      "enum": [
        "Submitted",
        "InReview",
        "Approved",
        "Rejected",
        "Fulfilled",
        "Cancelled"
      ]
    },
    "approverPosition": {
      "description": "Name of an approver position. Deliberately not an enum: positions may become data in the API, so new values can appear without a version bump. Consumers treat it as an opaque label (see README, Rules for consumers).",
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$",
      "maxLength": 50,
      "examples": [
        "DepartmentHead",
        "ItManager",
        "HrManager",
        "FinanceManager",
        "GeneralManager"
      ]
    },
    "approvalScope": {
      "type": "string",
      "enum": [
        "RequesterDepartment",
        "Global"
      ]
    },
    "stepDecision": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected",
        "Skipped",
        "Cancelled"
      ]
    },
    "auditAction": {
      "type": "string",
      "enum": [
        "Submitted",
        "StepApproved",
        "StepRejected",
        "Fulfilled",
        "Cancelled",
        "StepEscalated"
      ]
    },
    "stepOrder": {
      "type": "integer",
      "minimum": 1
    },
    "step": {
      "description": "One approval step as it exists on the request.",
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/$defs/stepOrder"
        },
        "position": {
          "$ref": "#/$defs/approverPosition"
        },
        "scope": {
          "$ref": "#/$defs/approvalScope"
        },
        "escalatedFrom": {
          "description": "Original position when the step was escalated because the requester holds it; null otherwise.",
          "anyOf": [
            {
              "$ref": "#/$defs/approverPosition"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "order",
        "position",
        "scope",
        "escalatedFrom"
      ],
      "additionalProperties": false
    },
    "actionableStep": {
      "description": "A step someone must now decide, with the users the API resolved as eligible at publish time. See README: approverUserIds.",
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/$defs/stepOrder"
        },
        "position": {
          "$ref": "#/$defs/approverPosition"
        },
        "scope": {
          "$ref": "#/$defs/approvalScope"
        },
        "escalatedFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/approverPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "approverUserIds": {
          "description": "May be empty. Consumers must not fail silently on empty; see README.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "order",
        "position",
        "scope",
        "escalatedFrom",
        "approverUserIds"
      ],
      "additionalProperties": false
    },
    "decidedStep": {
      "description": "The step that was just decided.",
      "type": "object",
      "properties": {
        "order": {
          "$ref": "#/$defs/stepOrder"
        },
        "position": {
          "$ref": "#/$defs/approverPosition"
        },
        "scope": {
          "$ref": "#/$defs/approvalScope"
        }
      },
      "required": [
        "order",
        "position",
        "scope"
      ],
      "additionalProperties": false
    },
    "comment": {
      "description": "Matches ApprovalStep.CommentMaxLength (500).",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
