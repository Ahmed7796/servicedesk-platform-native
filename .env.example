# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
# Every variable below is required; `docker compose up` stops with a message naming any that is missing.

# Base64-encoded HMAC key (32 random bytes) used to sign JWT access tokens.
# Generate one with:  openssl rand -base64 32
JWT_SECRET_KEY=

# SQL Server SA password (servicedesk-api's database). SQL Server requires at least 8 characters
# with upper case, lower case, a digit and a symbol. Avoid ; and = (they break the connection string).
# Example generator:  echo "Sd1!$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 24)"
# Only applied when the volume is first created; after changing it run `docker compose down -v`.
MSSQL_SA_PASSWORD=

# PostgreSQL password for the notification service (database and user are both `notify`).
# Generate:  openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 24
# Only applied when the volume is first created; after changing it run `docker compose down -v`.
POSTGRES_PASSWORD=

# RabbitMQ credentials (management UI at http://localhost:15672).
RABBITMQ_DEFAULT_USER=servicedesk
RABBITMQ_DEFAULT_PASS=

# Running the API outside Docker (`dotnet run`) against the Compose database:
#   export ConnectionStrings__Default="Server=localhost,1433;Database=ServiceDesk;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True"
# Until task M0-5 is done, appsettings.Development.json still holds an old hardcoded password,
# and this variable overrides it.
