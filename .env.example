# Copy to .env (git-ignored) and fill in. docker compose reads it automatically.
# Every variable below is required; `docker compose up` stops with a message naming any that is missing.

# Base64-encoded HMAC key (32 random bytes) used to sign JWT access tokens.
# Generate one with:  openssl rand -base64 32
JWT_SECRET_KEY=

# PostgreSQL password for servicedesk-api's own database (database and user are both `servicedesk`).
# Avoid ; and = (they break the connection string).
# Generate:  openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 24
# Only applied when the volume is first created; after changing it run `docker compose down -v`.
API_DB_PASSWORD=

# PostgreSQL password for the notification service (database and user are both `notify`).
# Generate:  openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 24
# Only applied when the volume is first created; after changing it run `docker compose down -v`.
POSTGRES_PASSWORD=

# Optional. How long an approval step may stay pending before GET /notify/overdue lists it (ISO-8601).
# Default PT24H. Set PT1M to demo overdue steps quickly.
# NOTIFY_STEP_SLA=PT24H

# Push notifications through Expo (notification-service, M2-4a). Optional.
# NOTIFY_PUSH_ENABLED=true
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# RabbitMQ credentials (management UI at http://localhost:15672). In Compose the API reuses them as
# RabbitMq__User / RabbitMq__Password, with RabbitMq__Host=rabbitmq.
RABBITMQ_DEFAULT_USER=servicedesk
RABBITMQ_DEFAULT_PASS=

# Client credentials for the triage copilot (POST /api/auth/service-token). Both the API and the copilot read them.
# The secret must be at least 32 characters.
# Generate:  openssl rand -base64 32
TRIAGE_CLIENT_ID=triage-copilot
TRIAGE_CLIENT_SECRET=

# Gemini API key for the triage copilot (M3-3b). Leave empty to run without triage suggestions.
GEMINI_API_KEY=
# Optional. Model id; default gemini-3.5-flash-lite (gemini-2.5-flash is closed to new keys).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Running the API outside Docker (`dotnet run`) against the Compose database (host port 5433):
#   export ConnectionStrings__Default="Host=localhost;Port=5433;Database=servicedesk;Username=servicedesk;Password=<API_DB_PASSWORD>"
# and, for the outbox publisher:
#   export RabbitMq__Host=localhost RabbitMq__User=<RABBITMQ_DEFAULT_USER> RabbitMq__Password=<RABBITMQ_DEFAULT_PASS>
#   export ServiceClients__Triage__ClientId=<TRIAGE_CLIENT_ID> ServiceClients__Triage__ClientSecret=<TRIAGE_CLIENT_SECRET>
